+fn infantry_scale() -> Result<f32, String> {
+    let path = std::path::Path::new(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../art/source/spice/infantry-idle/model.glb"
+    ));
+    let mut bytes = Vec::new();
+    std::fs::File::open(path)
+        .map_err(|error| error.to_string())?
+        .take(32 * 1024 * 1024 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|error| error.to_string())?;
+    if bytes.len() > 32 * 1024 * 1024 {
+        return Err("Infantry GLB exceeds 32 MiB".into());
+    }
+    let length = u32::from_le_bytes(
+        bytes
+            .get(12..16)
+            .ok_or("Truncated GLB")?
+            .try_into()
+            .map_err(|_| "Invalid GLB header")?,
+    ) as usize;
+    let document: serde_json::Value =
+        serde_json::from_slice(bytes.get(20..20 + length).ok_or("Truncated GLB JSON")?)
+            .map_err(|error| error.to_string())?;
+    let asset = &document["extras"]["spice_cad"];
+    if asset["schema_version"] != 1 || asset["asset_id"] != "spice-cad/infantry" {
+        return Err("Unsupported infantry contract".into());
+    }
+    let reference = &asset["references"]["body"];
+    if reference["space"] != "exported world" || reference["units"] != "metres" {
+        return Err("Invalid body reference coordinates".into());
+    }
+    let height = reference["size"][1]
+        .as_f64()
+        .ok_or("Missing body reference height")?;
+    if !height.is_finite() || height <= 0.0 {
+        return Err("Invalid body reference height".into());
+    }
+    let scale = f64::from(LEVY_REFERENCE_HEIGHT) / height;
+    if !(0.0001..=10000.0).contains(&scale) {
+        return Err("Infantry scale exceeds limits".into());
+    }
+    Ok(scale as f32)
+}
